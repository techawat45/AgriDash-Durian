# พอร์ตสำหรับรัน Web Application
PORT=3000

# การเชื่อมต่อฐานข้อมูล MongoDB Atlas (แทนที่ด้วย Connection String ของคุณ)
# ตัวอย่าง: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agridash?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agridash?retryWrites=true&w=majority

# Google Sheets Backup Integration (ใส่ ID แผ่นงาน Google Sheets สำรอง)
GOOGLE_SHEET_ID=1Z5VJksCIxIYji6FrmG2faT4M27yXbnlg-rbP3e9koOY
